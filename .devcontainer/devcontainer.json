{
  "name": "Hidden-Robotics (ROS 2 Jazzy + PlatformIO)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "hidden-robotics-ros2",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "platformio.platformio-ide",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "postCreateCommand": "chmod +x test_omni_e2e.sh && ./test_omni_e2e.sh"
}
